        "@tanstack/react-query-devtools": "^5.91.1",
        "@use-gesture/react": "^10.3.1",
        "axios": "^1.13.2",
        "beasties": "^0.3.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.556.0",
        "maplibre-gl": "^5.16.0",
        "next": "16.0.7",
        "react": "19.2.0",
