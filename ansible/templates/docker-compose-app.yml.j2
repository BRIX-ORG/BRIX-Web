services:
  {{ app_container }}:
    image: {{ custom_image | default(dockerhub_image + ':' + image_tag) }}
    container_name: {{ app_container }}
    restart: always
    expose:
      - "3000"
    networks:
      - {{ docker_network }}
    labels:
      com.centurylinklabs.watchtower.enable: "true"
      environment: "{{ env_name }}"
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

networks:
  {{ docker_network }}:
    external: true
